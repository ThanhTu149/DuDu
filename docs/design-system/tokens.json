{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DuDu",
  "description": "Bộ token của bảng điều phối DuDu. Tệp này import được vào Figma qua plugin Tokens Studio (Figma → Plugins → Tokens Studio → Import). Sửa ở đây rồi cập nhật web/assets/app.css để hai bên khớp nhau.",
  "color": {
    "paper": { "$type": "color", "$value": "#f5f2ec", "$description": "nền toàn màn hình" },
    "paper-2": { "$type": "color", "$value": "#faf8f4", "$description": "mặt phẳng của panel" },
    "ink": { "$type": "color", "$value": "#1c1917", "$description": "chữ chính, rail trái" },
    "ink-2": { "$type": "color", "$value": "#57534e" },
    "ink-3": { "$type": "color", "$value": "#6b6560" },
    "line": { "$type": "color", "$value": "#ddd7cb", "$description": "viền 1px" },
    "line-soft": { "$type": "color", "$value": "#e9e4da" },
    "accent": { "$type": "color", "$value": "#c9490e", "$description": "màu nhấn duy nhất: nút chính, tuyến chọn" },
    "accent-soft": { "$type": "color", "$value": "#f7e4d8" },
    "teal": { "$type": "color", "$value": "#2c6b52", "$description": "trạng thái tốt" },
    "teal-soft": { "$type": "color", "$value": "#dcebe3" },
    "alert": { "$type": "color", "$value": "#b3261e", "$description": "đơn trễ, vượt tải" },
    "alert-soft": { "$type": "color", "$value": "#f8dfdc" },
    "amber": { "$type": "color", "$value": "#d99a06", "$description": "cảnh báo mềm" },
    "route-1": { "$type": "color", "$value": "#c9490e" },
    "route-2": { "$type": "color", "$value": "#2c6b52" },
    "route-3": { "$type": "color", "$value": "#2f5d8c" },
    "route-4": { "$type": "color", "$value": "#8a6100" },
    "route-5": { "$type": "color", "$value": "#6b3f8c" },
    "route-6": { "$type": "color", "$value": "#a3402d" },
    "route-7": { "$type": "color", "$value": "#2f7c7c" },
    "route-8": { "$type": "color", "$value": "#5c6b2f" }
  },
  "typography": {
    "font": {
      "sans": { "$type": "fontFamily", "$value": ["Be Vietnam Pro", "Segoe UI Variable Text", "Segoe UI", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "Cascadia Mono", "Consolas", "monospace"] }
    },
    "size": {
      "label": { "$type": "dimension", "$value": "10px" },
      "kicker": { "$type": "dimension", "$value": "11px" },
      "small": { "$type": "dimension", "$value": "12px" },
      "body": { "$type": "dimension", "$value": "13px" },
      "lead": { "$type": "dimension", "$value": "14px" },
      "title": { "$type": "dimension", "$value": "17px" },
      "kpi": { "$type": "dimension", "$value": "20px" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.45 }
    },
    "letterSpacing": {
      "label": { "$type": "dimension", "$value": "0.12em" }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "6px" },
    "3": { "$type": "dimension", "$value": "8px" },
    "4": { "$type": "dimension", "$value": "10px" },
    "5": { "$type": "dimension", "$value": "12px" },
    "6": { "$type": "dimension", "$value": "14px" },
    "7": { "$type": "dimension", "$value": "16px" },
    "8": { "$type": "dimension", "$value": "20px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "7px" },
    "lg": { "$type": "dimension", "$value": "10px" },
    "pill": { "$type": "dimension", "$value": "20px" }
  },
  "border": {
    "hairline": { "$type": "border", "$value": { "color": "{color.line}", "width": "1px", "style": "solid" } }
  },
  "shadow": {
    "panel": { "$type": "shadow", "$value": { "color": "#15171c14", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px" } }
  },
  "layout": {
    "breakpoint": {
      "narrow": { "$type": "dimension", "$value": "900px" },
      "stack": { "$type": "dimension", "$value": "1240px" },
      "compactToolbar": { "$type": "dimension", "$value": "1460px" }
    },
    "railWidth": { "$type": "dimension", "$value": "64px" },
    "sidePanel": { "$type": "dimension", "$value": "400px" },
    "drawer": { "$type": "dimension", "$value": "400px" },
    "drawerWide": { "$type": "dimension", "$value": "780px" }
  }
}

